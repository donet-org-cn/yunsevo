<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!-- Android has no CIDR rule. CloudConnection enforces literal LAN/loopback HTTP
       on every request and disables redirects; public endpoints require HTTPS. -->
  <base-config cleartextTrafficPermitted="true"><trust-anchors><certificates src="system" /></trust-anchors></base-config>
</network-security-config>
