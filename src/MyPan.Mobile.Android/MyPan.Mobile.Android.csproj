<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <ApplicationId>app.yunsevo.drive</ApplicationId>
    <ApplicationTitle>沄序</ApplicationTitle>
    <ApplicationDisplayVersion>1.3.7</ApplicationDisplayVersion>
    <ApplicationVersion>11</ApplicationVersion>
    <ReconstructionAbi Condition="'$(RuntimeIdentifier)' == 'android-arm64'">arm64-v8a</ReconstructionAbi>
    <ReconstructionAbi Condition="'$(RuntimeIdentifier)' == 'android-x64'">x86_64</ReconstructionAbi>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <AndroidAsset Include="../../artifacts/reconstruction-native/masks/*.onnx" Link="Assets/reconstruction-masks/%(Filename)%(Extension)" LogicalName="reconstruction-masks/%(Filename)%(Extension)" />
    <AndroidAsset Include="../../artifacts/reconstruction-native/masks/LICENSE*" Link="Assets/Notices/reconstruction/%(Filename)%(Extension)" LogicalName="Notices/reconstruction/%(Filename)%(Extension)" />
    <ProjectReference Include="../MyPan.Mobile.Core/MyPan.Mobile.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AndroidAsset Include="../../artifacts/reconstruction-native/android/$(RuntimeIdentifier)/Notices/**/*" Link="Assets/Notices/reconstruction/%(RecursiveDir)%(Filename)%(Extension)" LogicalName="Notices/reconstruction/%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="../MyPan.ModelViewer/*" Link="Assets/model-viewer/%(Filename)%(Extension)" LogicalName="model-viewer/%(Filename)%(Extension)" />
    <AndroidNativeLibrary Include="../../artifacts/reconstruction-native/android/$(RuntimeIdentifier)/*.so" Abi="$(ReconstructionAbi)" Link="lib/$(ReconstructionAbi)/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2" />
  </ItemGroup>
  <Target Name="RequireReconstructionRuntime" BeforeTargets="PrepareForBuild" Condition="'$(Configuration)' == 'Release'">
    <Error Condition="!Exists('../../artifacts/reconstruction-native/masks/encoder.onnx') Or !Exists('../../artifacts/reconstruction-native/masks/decoder.onnx') Or !Exists('../../artifacts/reconstruction-native/masks/LICENSE-MobileSAM.txt')" Text="Export verified foreground models with tools/reconstruction/export_mobile_masks.py before publishing." />
    <Error Condition="!Exists('../../artifacts/reconstruction-native/android/$(RuntimeIdentifier)/libyunsevo_reconstruction.so')" Text="Build native reconstruction first: scripts/build-reconstruction.ps1 -Runtime $(RuntimeIdentifier)" />
  </Target>
</Project>
