#version 450
layout(local_size_x=64) in;
layout(std430,binding=0) readonly buffer Data { float image[]; };
layout(std430,binding=1) readonly buffer Params { vec4 param[]; };
layout(std430,binding=2) writeonly buffer Result { float depths[]; };
float sampleImage(int source, vec2 q, int w, int h) {
 if(q.x<0.0||q.y<0.0||q.x>=float(w-1)||q.y>=float(h-1)) return -1.0;
 ivec2 i=ivec2(floor(q));vec2 a=fract(q);int base=(source*w*h)+i.y*w+i.x;
 return mix(mix(image[base],image[base+1],a.x),mix(image[base+w],image[base+w+1],a.x),a.y);
}
float costAt(float z,int x,int y,int radius,float a,float va) {
 int w=int(param[0].x),h=int(param[0].y),sources=int(param[0].w);float f=param[1].z,cx=param[1].w,cy=param[2].x;
 float best=2.0,second=2.0;int valid=0;float n=float((radius*2+1)*(radius*2+1));
 for(int s=0;s<sources;s++) {
  vec4 r0=param[3+s*3],r1=param[4+s*3],r2=param[5+s*3];float b=0.0,bb=0.0,ab=0.0;bool ok=true;
  for(int dy=-radius;dy<=radius;dy++)for(int dx=-radius;dx<=radius;dx++) {
   vec4 p=vec4((float(x+dx)-cx)*z/f,(float(y+dy)-cy)*z/f,z,1.0);vec3 q=vec3(dot(r0,p),dot(r1,p),dot(r2,p));
   float u=q.z>0.0?sampleImage(s+1,vec2(f*q.x/q.z+cx,f*q.y/q.z+cy),w,h):-1.0;float v=image[(y+dy)*w+x+dx];if(u<0.0)ok=false;b+=u;bb+=u*u;ab+=u*v;
  }
  float vb=bb-b*b/n;
  if(ok&&va>0.00015&&vb>0.00015){float c=1.0-clamp((ab-a*b/n)/sqrt(va*vb),-1.0,1.0);if(c<best){second=best;best=c;}else second=min(second,c);valid++;}
 }
 return valid>=2?(best+second)*0.5:2.0;
}
void main() {
 int w=int(param[0].x),h=int(param[0].y),planes=int(param[0].z),index=int(gl_GlobalInvocationID.x);if(index>=w*h)return;
 int x=index%w,y=index/w;depths[index]=0.0;if(x<3||y<3||x>=w-3||y>=h-3)return;
 float nearInv=1.0/param[1].x,farInv=1.0/param[1].y,stepInv=(farInv-nearInv)/float(planes-1);
 float a3=0.0,aa3=0.0,a5=0.0,aa5=0.0;
 for(int dy=-2;dy<=2;dy++)for(int dx=-2;dx<=2;dx++){float v=image[(y+dy)*w+x+dx];a5+=v;aa5+=v*v;if(abs(dx)<=1&&abs(dy)<=1){a3+=v;aa3+=v*v;}}
 float va3=aa3-a3*a3/9.0,va5=aa5-a5*a5/25.0;if(va3<0.00015||va5<0.00015)return;
 float best=2.0,bestPlane=0.0;
 for(int plane=0;plane<planes;plane++){float c=costAt(1.0/(nearInv+float(plane)*stepInv),x,y,1,a3,va3);if(c<best){best=c;bestPlane=float(plane);}}
 if(best>0.4)return;
 float refined=2.0,result=0.0;
 for(int k=-4;k<=4;k++){float plane=clamp(bestPlane+float(k)*0.2,0.0,float(planes-1));float z=1.0/(nearInv+plane*stepInv);float c=costAt(z,x,y,2,a5,va5);if(c<refined){refined=c;result=z;}}
 if(refined<0.25)depths[index]=result;
}
